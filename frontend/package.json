    "@types/node": "^24.13.3",
    "@types/uuid": "^9.0.7",
    "autoprefixer": "^10.5.4",
    "browser-sync": "^3.0.0",
    "chokidar": "^3.6.0",
    "chromatic": "^13.3.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "glob-parent": "^5.1.2",
    "jasmine-core": "~5.13.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "karma-junit-reporter": "^2.0.1",
    "postcss": "^8.5.19",
    "prettier": "^3.9.5",
    "readdirp": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.64.0"
