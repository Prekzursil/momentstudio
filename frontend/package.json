    "http-proxy-middleware": "3.0.7",
    "piscina": "5.2.0",
    "uuid": "11.1.1",
    "@hono/node-server": "^2.0.5",
    "body-parser@^1": "^1.20.6",
    "brace-expansion@^1": "^1.1.16",
    "brace-expansion@^5": "^5.0.8",
    "fast-uri@^3": "^3.1.4",
    "fast-uri@^4": "^4.1.1",
    "fast-xml-parser": "^5.10.1",
    "find-my-way": "^9.7.0",
    "immutable@^3": "^4.3.9",
    "postcss": "$postcss",
