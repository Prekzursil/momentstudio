  "//overrides": [
    "Transitive-dependency CVE pins for the osv-scanner deps gate (upgrade-to-clear",
    "per osv-scanner.toml policy). Same convention as backend/requirements.txt.",
    "Pulled in transitively; pinned to the advisory's fixed version.",
    "A 'name@range' key scopes the pin to the copies that request that major, so a",
    "sibling copy on a different major (already clear) is left untouched.",
    "  @hono/node-server >=2.0.5  GHSA-frvp-7c67-39w9 (via @modelcontextprotocol/sdk)",
    "  body-parser@^1    >=1.20.6 GHSA-v422-hmwv-36x6 (via karma; top-level 2.3.0 is clear)",
    "  brace-expansion@^1 >=1.1.16 GHSA-3jxr-9vmj-r5cp (via minimatch@3)",
    "  brace-expansion@^5 >=5.0.8  GHSA-mh99-v99m-4gvg (via minimatch@10)",
    "                             RESIDUAL: GHSA-mh99-v99m-4gvg (published 2026-07-24) has no",
    "                             1.x/2.x backport - its only fix is 5.0.8, whose CJS build",
    "                             exports a named 'expand' instead of a callable default, so",
    "                             forcing it under minimatch@3 (eslint, karma, glob) or",
    "                             minimatch@9 (@wdio/config) throws 'expand is not a function'.",
    "                             Measured; only minimatch@10 tolerates 5.0.8. Left unpinned",
    "                             pending an upstream backport or a reviewed minimatch bump.",
    "  dompurify         >=3.4.12 GHSA-c2j3-45gr-mqc4 (nested under @toast-ui/editor)",
    "  fast-uri@^3       >=3.1.4  GHSA-v2hh-gcrm-f6hx (via ajv)",
    "  fast-uri@^4       >=4.1.1  GHSA-v2hh-gcrm-f6hx (via @fastify/fast-json-stringify-compiler)",
    "  fast-xml-parser   >=5.10.1 GHSA-8r6m-32jq-jx6q (via edgedriver)",
    "  find-my-way       >=9.7.0  GHSA-c96f-x56v-gq3h (via fastify)",
    "  hono              >=4.12.27 GHSA-hvrm-45r6-mjfj, GHSA-w62v-xxxg-mg59, GHSA-xgm2-5f3f-mvvc",
    "  immutable@^3      >=4.3.9  GHSA-v56q-mh7h-f735, GHSA-xvcm-6775-5m9r (via browser-sync;",
    "                             sass's 5.1.9 copy is already >=5.1.8 so it is left alone)",
    "  postcss           $postcss (>=8.5.18) GHSA-r28c-9q8g-f849 (nested 8.5.12 under",
    "                             @angular-devkit/build-angular; tracks the direct devDep spec)",
    "  sharp             >=0.35.0 GHSA-f88m-g3jw-g9cj (via @applitools/image)",
    "  tar               >=7.5.22 GHSA-23hp-3jrh-7fpw, GHSA-8x88-c5mf-7j5w, GHSA-gvwx-54wh-qm9j,",
    "                             GHSA-r292-9mhp-454m, GHSA-w8wr-v893-vjvp (via node-gyp, pacote)",
    "  webpack-dev-server >=5.2.6 GHSA-f5vj-f2hx-8m93, GHSA-m28w-2pqf-7qgj (via @angular-devkit)"
  ],
  "overrides": {
    "@toast-ui/editor": {
      "dompurify": "^3.4.12"
    },
